# Copy to .env and adjust. Values shown are the worker defaults.

# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=unime_video_catalog
MONGO_COLLECTION=videos
FOLDERS_COLLECTION=folders

# Archive import (import_videos.py) — edit for your Windows paths
IMPORT_BASE_DIR=C:/Users/ciam/unime.it/Part-Time Multimedia - Backup_CD
IMPORT_OUTPUT_DIR=C:/UniMe-AI/converted_videos
# IMPORT_LIST_FILE=C:/path/to/Elenco video.txt
IMPORT_MAX_VIDEOS=1          # set 0 for no limit; use 1 for a single-video test

# Device: cuda or cpu (use cpu on laptops without CUDA 12)
DEVICE=cpu

# faster-whisper (small + int8 is a good laptop test profile)
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_NUM_WORKERS=1
WHISPER_BATCH_SIZE=16
WHISPER_BEAM_SIZE=2

# Ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma4:latest
OLLAMA_NUM_CTX=24576
OLLAMA_NUM_BATCH=2048
OLLAMA_TIMEOUT_SECONDS=600

# Worker runtime
TEMP_DIR=.
STALE_PROCESSING_MINUTES=30
DOWNLOAD_QUEUE_SIZE=3
WHISPER_QUEUE_SIZE=2
MAX_SUMMARY_RETRIES=3
OMP_NUM_THREADS=8
