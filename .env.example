# Copy to .env and adjust. Values shown are the worker defaults.

# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=unime_video_catalog
MONGO_COLLECTION=videos

# Device: cuda or cpu
DEVICE=cuda

# faster-whisper
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=float16
WHISPER_NUM_WORKERS=4
WHISPER_BATCH_SIZE=16
WHISPER_BEAM_SIZE=2

# Ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma4:latest
OLLAMA_NUM_CTX=24576
OLLAMA_NUM_BATCH=2048
OLLAMA_TIMEOUT_SECONDS=600

# Worker runtime
TEMP_DIR=.
STALE_PROCESSING_MINUTES=30
DOWNLOAD_QUEUE_SIZE=3
WHISPER_QUEUE_SIZE=2
MAX_SUMMARY_RETRIES=3
OMP_NUM_THREADS=8
